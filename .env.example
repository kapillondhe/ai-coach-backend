APP_NAME="AI Coach API"
ENVIRONMENT=development
# DEBUG defaults to false when unset; turn it on for local development only.
DEBUG=true
CORS_ORIGINS=http://localhost:3000

OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_UTILITY_MODEL=z-ai/glm-5.3-flash
OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# Requests/minute to /api/coach/chat(/stream) per user (or client IP when anonymous),
# counted per worker process; 0 disables.
CHAT_RATE_LIMIT_PER_MINUTE=20
# Proxies in front of the app that append to X-Forwarded-For (FastAPI Cloud: 2); the
# anonymous rate-limit IP is the entry this many places from the right. 0 ignores the header.
TRUSTED_PROXY_HOPS=2

PHOENIX_API_KEY=
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
PHOENIX_PROJECT_NAME=ai-coach
OTEL_SERVICE_NAME=ai-coach-backend

DATABASE_URL=

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
TOKEN_ENCRYPTION_KEY=
COROS_MCP_SERVER_URL=https://mcp.coros.com/mcp
COROS_REDIRECT_URI=http://localhost:8000/api/integrations/coros/callback
FRONTEND_URL=http://localhost:3000

# Shared secret for POST /api/internal/sync/run (scheduled COROS sync); unset disables it.
INTERNAL_SYNC_SECRET=
