APP_NAME="AI Coach API"
ENVIRONMENT=development
# DEBUG defaults to false when unset; turn it on for local development only.
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# Knowledge-base vector search - `docker compose up -d` for local Qdrant, then
# `python -m scripts.ingest_knowledge_base`. Production: Qdrant Cloud URL + API key.
# Embeddings run on Qdrant Cloud (Cloud Inference) when QDRANT_URL is a *.cloud.qdrant.io
# URL, and locally via fastembed otherwise; QDRANT_CLOUD_INFERENCE=true/false overrides.
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=               # required for Qdrant Cloud; unset for local Qdrant
QDRANT_COLLECTION=coaching_kb
# QDRANT_CLOUD_INFERENCE=       # unset = auto-detect from QDRANT_URL

OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_UTILITY_MODEL=z-ai/glm-5.3-flash
OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# Requests/minute to /api/coach/chat(/stream) per user (or client IP when anonymous),
# counted per worker process; 0 disables.
CHAT_RATE_LIMIT_PER_MINUTE=20

PHOENIX_API_KEY=
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
PHOENIX_PROJECT_NAME=ai-coach
OTEL_SERVICE_NAME=ai-coach-backend

DATABASE_URL=

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
TOKEN_ENCRYPTION_KEY=
COROS_MCP_SERVER_URL=https://mcp.coros.com/mcp
COROS_REDIRECT_URI=http://localhost:8000/api/integrations/coros/callback
FRONTEND_URL=http://localhost:3000

# Shared secret for POST /api/internal/sync/run (scheduled COROS sync); unset disables it.
INTERNAL_SYNC_SECRET=
