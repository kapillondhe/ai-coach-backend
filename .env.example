APP_NAME="AI Coach API"
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

MCP_SERVER_URL=https://your-mcp-server.example.com/mcp
# MCP_AUTH_TOKEN=              # must match the MCP server's MCP_AUTH_TOKEN, if set

# Pydantic AI coach agent (app/agents/)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Tracing (app/core/telemetry.py) - unset PHOENIX_API_KEY disables tracing entirely
PHOENIX_API_KEY=
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
PHOENIX_PROJECT_NAME=ai-coach
OTEL_SERVICE_NAME=ai-coach-backend
# Redact captured prompt/tool payloads instead of sending them raw to Phoenix Cloud:
# OPENINFERENCE_HIDE_INPUTS=true
# OPENINFERENCE_HIDE_OUTPUTS=true
