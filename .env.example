APP_NAME="AI Coach API"
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# backend -> MCP server (https://github.com/kapillondhe/ai-coach-mcp-server)
MCP_SERVER_URL=http://localhost:8100/mcp
# MCP_AUTH_TOKEN=              # must match the MCP server's MCP_AUTH_TOKEN, if set

# Pydantic AI coach agent (app/agents/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
